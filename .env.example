# Local Postgres (docker compose up -d, or brew postgresql@16). Vercel gets its URLs from the Supabase integration.
DATABASE_URL=postgresql://buku:buku@localhost:5432/buku
# Enables synthetic demo fixtures; reset is operator-only tooling
DEMO_MODE=true
# OpenAI-compatible LLM gateway (OpenCode Zen). Leave AI_API_KEY empty to run rules-only.
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=
AI_MODEL=
AI_MAX_CALLS_PER_RUN=20
AI_MONTHLY_TOKEN_BUDGET=200000
# Optional: per-call timeouts in ms (defaults 90000 for classification/mapping, 180000 for close review / Jelaskan)
# AI_TIMEOUT_MS=90000
# AI_LONG_TIMEOUT_MS=180000
# Authenticated document workspace; false disables documents operationally
EVIDENCE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# ≥ 32 chars; encrypts the AI key saved in Pengaturan and the Drive token
SETTINGS_SECRET=

# Login = Supabase Auth (email + password). Local dev uses the local stack (ADR 0015): `npm run auth:local` (Docker) starts it and fills
# these three lines. Never the production project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Needed by `npm run access` (invites / revoke), the demo admin and e2e.
SUPABASE_SECRET_KEY=
# Public origin used in invite / reset links (defaults to the request origin, or the project's Site URL for CLI invites)
APP_URL=http://localhost:3000
# Server-only public contact. Leave empty for the neutral contact fallback; use a monitored address when publishing.
BUKU_SUPPORT_EMAIL=
# Demo admin login, created by the seed (DEMO_MODE=true only). Pick any email; password ≥ 8 chars.
DEMO_ADMIN_EMAIL=admin@buku.local
DEMO_ADMIN_PASSWORD=
# Build-time bootstrap for a real workspace (Vercel production): firm name + first admin invitation.
# INITIAL_FIRM_NAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_NAME=
