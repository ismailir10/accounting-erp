+}
+
+/**
+ * Whether a source amount reached exactly half a Rupiah (…,50 sen) only by rounding sub-sen digits **up**: 1.234,497 → 1.234,50 sen.
+ * Rounding that sen value to Rupiah again would give 1.235, where the source amount rounds once to 1.234 (accounting-rules 6a: round
+ * the source amount, half-up, per line). `roundEntry` breaks such a tie toward zero for currencies without sen (IDR, JPY).
+ */
+export function senTieFromBelow(input: string | number | bigint | null | undefined): boolean {
+  try {
+    const { cents, roundedAway } = parseCentsDetail(input);
+    return roundedAway && (cents < 0n ? -cents : cents) % 100n === 50n;
+  } catch {
+    return false;
+  }
+}
+
+function parseCentsDetail(input: string | number | bigint | null | undefined): { cents: bigint; roundedAway: boolean } {
+  if (input === null || input === undefined) return { cents: 0n, roundedAway: false };
+  if (typeof input === "bigint") return { cents: input * 100n, roundedAway: false };
