+export function roundEntry(cents: bigint[], currency: string, tiesFromBelow?: boolean[]): { rounded: bigint[]; rounding: bigint; total: bigint } {
+  const e = exponentOf(currency);
+  // A …,50 sen line that the source only reached by rounding up rounds toward zero here: one rounding of the source amount (rule 6a).
+  const half = e < 2 ? 10n ** BigInt(2 - e) / 2n : 0n;
+  const rounded = cents.map((c, i) => {
+    if (half && tiesFromBelow?.[i] && (c < 0n ? -c : c) % (half * 2n) === half) return (c - (c < 0n ? -half : half)) / (half * 2n);
+    return centsToMinor(c, currency);
+  });
