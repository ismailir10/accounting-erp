+  it("knows a …,50 sen reached only by rounding up from below", () => {
+    expect(senTieFromBelow(1234.497123)).toBe(true); // a spreadsheet float with six real decimals
+    expect(senTieFromBelow("1234.4951")).toBe(true); // ("1234.495" alone reads as a thousands group, as before)
+    expect(senTieFromBelow(-1234.497123)).toBe(true);
+    expect(senTieFromBelow(1234.5)).toBe(false); // a real half: half-up stays up
+    expect(senTieFromBelow(1234.503)).toBe(false); // rounded down to …,50: still ≥ half
+    expect(senTieFromBelow(1234.4949)).toBe(false); // …,49 sen: no tie
+    expect(senTieFromBelow(93375132.07000001)).toBe(false); // float noise only
+    expect(senTieFromBelow("1.234,497")).toBe(true);
